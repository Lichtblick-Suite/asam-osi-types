{
  "name": "@lichtblick/asam-osi-types",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "productName": "ASAM OSI Types",
  "productDescription": "Lichtblick Suite",
  "description": "ASAM Open Simulation Interface (ASAM OSI) types for Typescript",
  "author": {
    "name": "Lichtblick",
    "email": "lichtblick@bmwgroup.com"
  },
  "homepage": "https://www.asam.net/standards/detail/osi/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lichtblick-Suite/asam-osi-types.git"
  },
  "scripts": {
    "prepare": "ts-node scripts/generate-version-proto.ts",
    "generate": "yarn clean && yarn prepare && buf generate && ts-node scripts/generate-schema-definitions.ts && ts-node scripts/generate-index.ts",
    "build": "yarn generate && tsup index.ts --format cjs,esm --dts",
    "lint:ci": "eslint --report-unused-disable-directives .",
    "lint": "eslint --report-unused-disable-directives --fix .",
    "clean": "rimraf generated/ dist/ && ts-node scripts/generate-index.ts",
    "format": "prettier --write \"./**/*.{ts,js,json,md}\""
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.45.0",
    "@lichtblick/eslint-plugin": "^1.0.2",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-es": "4.1.0",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-prettier": "5.1.3",
    "prettier": "3.3.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.0",
    "typescript": "5.3.3"
  },
  "packageManager": "yarn@4.12.0"
}
